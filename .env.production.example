APP_ENV=production
APP_DEBUG=false
APP_PORT=8001
LOG_LEVEL=INFO

DATABASE_MODE=mysql
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=learnpilot
MYSQL_PASSWORD=replace-db-password
MYSQL_DATABASE=learning_agent

REDIS_URL=redis://redis:6379/0

ML_SERVICE_URL=http://ml-service:8000
USE_ML_SERVICE=true
ML_SERVICE_TIMEOUT_SECONDS=20

JWT_SECRET_KEY=replace-with-long-random-secret
JWT_EXPIRE_MINUTES=1440

LEARNPILOT_LLM_MODE=auto
DASHSCOPE_API_KEY=replace-dashscope-key

CORS_ORIGINS=*
